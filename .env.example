# Public base URL of the deployed site (no trailing slash).
VITE_SITE_URL=https://juleshaggard.github.io/DepartmentofConsentGithubPages

# Browser-safe Fourthwall Storefront token. Keep real values in a local .env
# file or the FOURTHWALL_STOREFRONT_TOKEN GitHub Actions secret.
VITE_FOURTHWALL_STOREFRONT_TOKEN=

# --- Booking ---------------------------------------------------------------
# External scheduling URL (Cal.com, Calendly, Acuity...). When empty, the
# booking page falls back to the inquiry form.
VITE_BOOKING_URL=

# Cal.com base profile URL.
# When set, the site derives the standard event URLs below from this base.
VITE_CAL_BASE_URL=https://cal.com/departmentofconsent

# Service-specific Cal.com event URLs for the pricing page. Leave blank until
# the corresponding event type is approved and published. These are public URLs,
# not secrets.
VITE_CAL_DISCOVERY_CALL_URL=
VITE_CAL_COACHING_SESSION_URL=
VITE_CAL_DEEP_DIVE_URL=
VITE_CAL_PACKAGE_URL=
VITE_CAL_EVENT_PREP_URL=
VITE_CAL_EVENT_COMPANION_INQUIRY_URL=

# Legacy fallback only. Remove after Cal.com links are tested live.
VITE_CALENDLY_DISCOVERY_CALL_URL=
VITE_CALENDLY_COACHING_SESSION_URL=
VITE_CALENDLY_DEEP_DIVE_URL=
VITE_CALENDLY_PACKAGE_URL=
VITE_CALENDLY_EVENT_PREP_URL=
VITE_CALENDLY_EVENT_COMPANION_INQUIRY_URL=

# --- Contact / inquiry form -------------------------------------------------
# Browser-safe form endpoint (e.g. Formspree https://formspree.io/f/XXXX or
# Basin). When empty, the form shows a "not connected" state and offers the
# contact email instead. Never fake successful submissions.
VITE_INQUIRY_FORM_ENDPOINT=
VITE_CONTACT_EMAIL=support@departmentofconsent.com

# --- Newsletter / email guide ------------------------------------------------
# Provider name for documentation purposes: buttondown | kit | mailchimp | loops
VITE_NEWSLETTER_PROVIDER=kit
# Browser-safe subscribe endpoint. Examples:
#   Buttondown: https://buttondown.com/api/emails/embed-subscribe/<username>
#   Kit:        https://app.kit.com/forms/<form-id>/subscriptions
#   Mailchimp:  the form action URL from an embedded form
# When empty, the email capture shows a development state.
VITE_NEWSLETTER_ENDPOINT=https://app.kit.com/forms/9683945/subscriptions
# Optional field-name override. Leave empty unless the provider requires it.
# Kit/ConvertKit automatically use "email_address"; most others use "email".
VITE_NEWSLETTER_EMAIL_FIELD=email_address

# --- Workshops ---------------------------------------------------------------
# Public workshop list signup URL. Falls back to the inquiry form when empty.
VITE_WORKSHOP_WAITLIST_URL=

# --- Analytics ---------------------------------------------------------------
# Privacy-friendly analytics (Plausible preferred; Fathom works the same way —
# swap the script src). Leave empty to disable analytics entirely.
VITE_GOOGLE_ANALYTICS_ID=G-GYYJEDCDTZ
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# --- Legal -------------------------------------------------------------------
# Legal entity name, once confirmed. Falls back to "Department of Consent".
VITE_LEGAL_NAME=
